dist/
# Re-include the embed placeholder's parent (git cannot re-include a file whose
# directory is excluded), then ignore the built assets inside it below.
!internal/webui/dist/

# The compiled frontend is embedded by Go (internal/webui). Ignore everything the
# build produces there but keep the committed placeholder so `go build` works on
# a fresh clone before any frontend build has run.
internal/webui/dist/*
!internal/webui/dist/index.html
web/dist/
