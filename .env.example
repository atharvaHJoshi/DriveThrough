# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
SERVER_PORT=8080
SERVER_ENV=development
SERVER_READ_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=120s
SERVER_REQUEST_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=15s

# Comma-separated. "*" is rejected when SERVER_ENV=production.
SERVER_ALLOWED_ORIGINS=*

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
# DATABASE_URL wins when set — use it for managed providers (RDS, Neon,
# Supabase, Cloud SQL). Leave empty to use the host/port fields below.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=drivethrough
DB_PASSWORD=drivethrough_secret
DB_NAME=drivethrough
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONNECT_TIMEOUT=10s
DB_RUN_MIGRATIONS=true

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# REDIS_URL wins when set and understands redis:// and rediss:// plus
# ?dial_timeout=5s style query parameters.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_TLS_SKIP_VERIFY=false
REDIS_CONNECT_TIMEOUT=5s

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Required. Production rejects short values and known defaults.
JWT_SECRET=dev-secret-change-me
JWT_ISSUER=drivethrough
# Accepts a Go duration or a bare number of minutes.
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
OTP_EXPIRY=5m
OTP_LENGTH=6

# ---------------------------------------------------------------------------
# SMS (msg91, or "log" to print the code in development)
# ---------------------------------------------------------------------------
SMS_PROVIDER=log
SMS_API_KEY=
SMS_BASE_URL=https://control.msg91.com/api/v5
SMS_SENDER_ID=DTTHRU

# ---------------------------------------------------------------------------
# Payments (empty credentials run in mock mode)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_WEBHOOK_TTL=300

# ---------------------------------------------------------------------------
# Push notifications (empty disables FCM)
# ---------------------------------------------------------------------------
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_KEY=
FCM_BASE_URL=https://fcm.googleapis.com

# ---------------------------------------------------------------------------
# Maps
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# WebSocket
# ---------------------------------------------------------------------------
WS_READ_BUFFER=4096
WS_WRITE_BUFFER=4096
WS_SEND_BUFFER=256
WS_PING_INTERVAL=30s
WS_PONG_TIMEOUT=90s
WS_WRITE_TIMEOUT=10s
# Empty allows any origin. Set a comma-separated list in production.
WS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# HTTP / rate limiting
# ---------------------------------------------------------------------------
HTTP_CLIENT_TIMEOUT=15s
RATE_LIMIT_GLOBAL=120
RATE_LIMIT_GLOBAL_WINDOW=60s
RATE_LIMIT_OTP=5
RATE_LIMIT_OTP_WINDOW=300s

# ---------------------------------------------------------------------------
# Pricing (INR)
# ---------------------------------------------------------------------------
BASE_DRIVER_FEE_PER_HOUR=150
PLATFORM_FEE=50
PROTECTION_FEE=20

# ---------------------------------------------------------------------------
# Matching
# ---------------------------------------------------------------------------
MAX_SEARCH_RADIUS_KM=5
DRIVER_ACCEPT_TIMEOUT_SEC=10
MAX_DRIVERS_TO_NOTIFY=5

# ---------------------------------------------------------------------------
# Background workers
# ---------------------------------------------------------------------------
# Set false when running more than one replica and only one should poll.
WORKERS_ENABLED=true
WORKER_SCHEDULED_POLL_INTERVAL=30s
WORKER_OFFER_EXPIRY_INTERVAL=15s
WORKER_STALE_SEARCH_INTERVAL=2m
WORKER_STALE_SEARCH_THRESHOLD=10m

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=text
